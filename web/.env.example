# 사이트 환경변수 (Vercel 프로젝트 설정에 넣는다. 전부 선택·공개 값 — 비밀 아님).
# 워드프레스를 쓰지 않는다. 글은 저장소 안 파일(web/content/)에서 직접 읽는다.

# 최종 사이트 주소
NEXT_PUBLIC_SITE_URL=https://astacgroup.com
# 소개 카드 문구(운영자 수정용, 선택)
NEXT_PUBLIC_INTRO_TITLE=
NEXT_PUBLIC_INTRO_DESC=
# 글 대표 실사진(Unsplash). 없으면 사진 생략.
UNSPLASH_ACCESS_KEY=
# 애드센스 게시자 ID (ca-pub-...). 승인·게재 시 광고 스크립트가 붙는다.
NEXT_PUBLIC_ADSENSE_CLIENT=
